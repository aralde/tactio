{
  "name": "tactio",
  "version": "1.0.0",
  "description": "Tactio - A productivity tool using LLMs for Copy. Transform. Paste.",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "build": "tsc",
    "build:portable": "tsc && electron-builder --win portable",
    "rebuild": "electron-rebuild -f -w robotjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "npmRebuild": false,
    "appId": "com.arieldeibe.tactio",
    "productName": "Tactio",
    "icon": "assets/tactio-logo.ico",
    "win": {
      "target": "portable",
      "artifactName": "${productName}Portable_${version}.${ext}",
      "icon": "assets/tactio-logo.ico"
    },
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.2.3",
    "robotjs": "^0.6.0"
  }
}