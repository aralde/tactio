{
  "name": "tactio",
  "version": "1.0.0",
  "description": "Tactio - A productivity tool using LLMs for Copy. Transform. Paste.",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build:renderer && tsc && electron .",
    "build": "npm run build:renderer && tsc",
    "build:renderer": "copy src\\renderer\\index.html dist\\renderer\\index.html && copy src\\renderer\\styles.css dist\\renderer\\styles.css && npx esbuild src/renderer/renderer.ts --bundle --outfile=dist/renderer/renderer.bundle.js --platform=browser --target=es2020",
    "build:portable": "npm run build:renderer && tsc && electron-builder --win portable",
    "rebuild": "electron-rebuild -f -w robotjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "npmRebuild": false,
    "appId": "com.aralde.tactio",
    "productName": "Tactio",
    "icon": "assets/tactio-logo.ico",
    "win": {
      "target": "portable",
      "artifactName": "${productName}Portable_${version}.${ext}",
      "icon": "assets/tactio-logo.ico"
    },
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^18.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.7.0",
    "electron-rebuild": "^2.0.3",
    "esbuild": "^0.27.3",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "adm-zip": "^0.5.16",
    "gray-matter": "^4.0.3",
    "robotjs": "^0.6.0"
  }
}
